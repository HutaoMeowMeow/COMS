@page
@model COMS.Pages.Alerts.IndexModel
@{
    ViewData["Title"] = "Alerts";
}

<div class="page-header">
    <div class="title-group">
        <h2 class="page-title mb-1">Obstruction Alerts</h2>
        <p class="page-subtitle mb-0">Track and resolve canal obstruction alerts.</p>
    </div>
    <div class="btn-group" role="group">
        <button class="btn btn-filter btn-outline-primary active" data-filter="all" type="button">All</button>
        <button class="btn btn-filter btn-outline-primary" data-filter="active" type="button">Active</button>
        <button class="btn btn-filter btn-outline-primary" data-filter="resolved" type="button">Resolved</button>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover" id="alertsTable">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Canal</th>
                        <th>Type</th>
                        <th>Severity</th>
                        <th>Status</th>
                        <th>Triggered At</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody id="alertsBody">
                </tbody>
            </table>
        </div>
        <div id="alertsEmpty" class="empty-state" style="display:none;">
            <i class="bi bi-clipboard-check"></i>
            <p class="empty-title">No alerts found</p>
            <p class="text-muted">There are currently no obstruction alerts to display.</p>
        </div>
    </div>
</div>

<div class="modal fade" id="updateAlertModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Update Alert</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="updateAlertForm">
                    <input type="hidden" id="alertId" />
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <select class="form-select" id="alertStatus">
                            <option value="Active">Active</option>
                            <option value="Resolved">Resolved</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Resolution Notes</label>
                        <textarea class="form-control" id="alertNotes" rows="3"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" onclick="updateAlert()">Update</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
const severityClass = s => s === 'High' ? 'severity-high' : s === 'Medium' ? 'severity-medium' : 'severity-low';
const statusClass = s => s === 'Active' ? 'bg-primary' : 'bg-success';

async function loadAlerts(filter = 'all') {
    showLoading();
    try {
        let url = '/api/Alerts';
        if (filter === 'active') url = '/api/Alerts/active';
        else if (filter === 'resolved') url = '/api/Alerts?status=Resolved';

        const response = await apiCall(url);
        if (response.ok) {
            const alerts = await response.json();
            const tbody = document.getElementById('alertsBody');
            const table = document.getElementById('alertsTable');
            const empty = document.getElementById('alertsEmpty');
            if (alerts.length === 0) {
                tbody.innerHTML = '';
                table.style.display = 'none';
                empty.style.display = 'block';
            } else {
                table.style.display = 'table';
                empty.style.display = 'none';
                tbody.innerHTML = alerts.map(a => `
                    <tr>
                        <td><strong>${a.title}</strong></td>
                        <td>${a.canalName}</td>
                        <td>${a.alertType}</td>
                        <td><span class="badge ${severityClass(a.severity)}">${a.severity}</span></td>
                        <td><span class="badge ${statusClass(a.status)}">${a.status}</span></td>
                        <td>${new Date(a.triggeredAt).toLocaleString()}</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-outline-primary" onclick="openUpdateModal('${a.id}', '${a.status}')">Update</button>
                        </td>
                    </tr>
                `).join('');
            }
        }
    } catch (e) {
        showAlert('Failed to load alerts: ' + e.message, 'danger');
    } finally {
        hideLoading();
    }
}

function setActiveFilter(btn) {
    document.querySelector('[data-filter].active').classList.remove('active');
    btn.classList.add('active');
}

function openUpdateModal(id, status) {
    document.getElementById('alertId').value = id;
    document.getElementById('alertStatus').value = status;
    new bootstrap.Modal(document.getElementById('updateAlertModal')).show();
}

async function updateAlert() {
    const id = document.getElementById('alertId').value;
    const status = document.getElementById('alertStatus').value;
    const notes = document.getElementById('alertNotes').value;

    const response = await apiCall(`/api/Alerts/${id}`, {
        method: 'PUT',
        body: JSON.stringify({ status, resolutionNotes: notes || undefined })
    });

    if (response.ok) {
        bootstrap.Modal.getInstance(document.getElementById('updateAlertModal')).hide();
        loadAlerts();
        showAlert('Alert updated', 'success');
    } else {
        showAlert('Failed to update alert', 'danger');
    }
}

document.addEventListener('DOMContentLoaded', () => {
    loadAlerts();
    document.querySelectorAll('[data-filter]').forEach(btn => {
        btn.addEventListener('click', () => {
            setActiveFilter(btn);
            loadAlerts(btn.dataset.filter);
        });
    });
});
initSignalR((type, data) => { if (type === 'alert') loadAlerts(); });
</script>
}
