@page
@model COMS.Pages.Canals.DetailsModel
@{
    ViewData["Title"] = Model.Canal?.Name ?? "Canal Details";
    var statusClass = Model.Canal?.Status == "Normal" ? "bg-success" :
                     Model.Canal?.Status == "Warning" ? "bg-warning" : "bg-danger";
}

<div class="page-header">
    <div class="title-group">
        <h2 class="page-title mb-1">@Model.Canal?.Name</h2>
        <p class="page-subtitle mb-0"><i class="bi bi-geo-alt"></i> @Model.Canal?.Location</p>
    </div>
    <a href="/Canals" class="btn btn-secondary">Back to Canals</a>
</div>

<div class="row g-4">
    <div class="col-xl-4">
        <div class="card h-100">
            <div class="card-header">Canal Information</div>
            <div class="card-body">
                <div class="info-grid">
                    <div class="info-item">
                        <span class="info-label">Location</span>
                        <span class="info-value">@Model.Canal?.Location</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Barangay</span>
                        <span class="info-value">@(Model.Canal?.Barangay ?? "N/A")</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Municipality</span>
                        <span class="info-value">@(Model.Canal?.Municipality ?? "N/A")</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Province</span>
                        <span class="info-value">@(Model.Canal?.Province ?? "N/A")</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Length</span>
                        <span class="info-value">@Model.Canal?.LengthMeters m</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Width</span>
                        <span class="info-value">@Model.Canal?.WidthMeters m</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Depth</span>
                        <span class="info-value">@Model.Canal?.DepthMeters m</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Normal Level</span>
                        <span class="info-value">@Model.Canal?.NormalWaterLevel m</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Warning Level</span>
                        <span class="info-value">@Model.Canal?.WarningWaterLevel m</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Critical Level</span>
                        <span class="info-value">@Model.Canal?.CriticalWaterLevel m</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Status</span>
                        <span class="badge @statusClass">@Model.Canal?.Status</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-8">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Sensors</span>
                <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addSensorModal">
                    <i class="bi bi-plus"></i> Add Sensor
                </button>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Code</th>
                                <th>Type</th>
                                <th>Location</th>
                                <th>Protocol</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Sensors.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center">
                                        <i class="bi bi-gear-fill"></i> No sensors registered for this canal.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var sensor in Model.Sensors)
                                {
                                    var sensorStatusClass = sensor.Status == "Online" ? "bg-success" : "bg-danger";
                                    <tr>
                                        <td><strong>@sensor.SensorCode</strong></td>
                                        <td>@sensor.SensorType</td>
                                        <td>@sensor.LocationDescription</td>
                                        <td>@sensor.CommunicationProtocol</td>
                                        <td><span class="badge @sensorStatusClass">@sensor.Status</span></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">Real-Time Readings</div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover" id="readingsTable">
                        <thead>
                            <tr>
                                <th>Sensor</th>
                                <th>Water Level</th>
                                <th>Flow Rate</th>
                                <th>Debris Level</th>
                                <th>Status</th>
                                <th>Timestamp</th>
                            </tr>
                        </thead>
                        <tbody id="readingsBody">
                        </tbody>
                    </table>
                    <div id="readingsEmpty" class="empty-state" style="display:none;">
                        <i class="bi bi-activity"></i>
                        <p class="empty-title">No readings available</p>
                        <p>Real-time sensor readings will appear here once data is recorded.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addSensorModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Sensor</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="addSensorForm">
                    <div class="mb-3">
                        <label class="form-label">Sensor Code</label>
                        <input type="text" class="form-control" id="sensorCode" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Type</label>
                        <select class="form-select" id="sensorType">
                            <option value="WaterLevel">Water Level</option>
                            <option value="FlowRate">Flow Rate</option>
                            <option value="Debris">Debris</option>
                            <option value="Multi">Multi-sensor</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Location Description</label>
                        <input type="text" class="form-control" id="sensorLocation" />
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Latitude</label>
                            <input type="number" step="any" class="form-control" id="sensorLat" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Longitude</label>
                            <input type="number" step="any" class="form-control" id="sensorLng" />
                        </div>
                    </div>
                    <div class="mb-3 mt-1">
                        <label class="form-label">Protocol</label>
                        <select class="form-select" id="sensorProtocol">
                            <option value="MQTT">MQTT</option>
                            <option value="LoRaWAN">LoRaWAN</option>
                            <option value="HTTP">HTTP</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" onclick="addSensor()">Add Sensor</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
async function loadReadings() {
    showLoading();
    try {
        const response = await apiCall(`/api/Readings/canal/${Model.Canal?.Id}?limit=20`);
        if (response.ok) {
            const readings = await response.json();
            const tbody = document.getElementById('readingsBody');
            const table = document.getElementById('readingsTable');
            const empty = document.getElementById('readingsEmpty');
            const statusBadge = r => r.readingStatus === 'Normal' ? 'bg-success' : r.readingStatus === 'Warning' ? 'bg-warning' : 'bg-danger';
            if (readings.length === 0) {
                tbody.innerHTML = '';
                table.style.display = 'none';
                empty.style.display = 'block';
            } else {
                table.style.display = 'table';
                empty.style.display = 'none';
                tbody.innerHTML = readings.map(r => `
                    <tr>
                        <td><strong>${r.sensorCode}</strong></td>
                        <td>${r.waterLevel.toFixed(2)} m</td>
                        <td>${r.flowRate.toFixed(2)}</td>
                        <td>${r.debrisLevel != null ? r.debrisLevel.toFixed(2) : 'N/A'}</td>
                        <td><span class="badge ${statusBadge(r)}">${r.readingStatus}</span></td>
                        <td>${new Date(r.readingTimestamp).toLocaleString()}</td>
                    </tr>
                `).join('');
            }
        }
    } catch (e) {
        showAlert('Failed to load readings: ' + e.message, 'danger');
    } finally {
        hideLoading();
    }
}

async function addSensor() {
    const data = {
        sensorCode: document.getElementById('sensorCode').value,
        sensorType: document.getElementById('sensorType').value,
        canalId: '@Model.Canal?.Id',
        locationDescription: document.getElementById('sensorLocation').value || undefined,
        latitude: parseFloat(document.getElementById('sensorLat').value) || 0,
        longitude: parseFloat(document.getElementById('sensorLng').value) || 0,
        communicationProtocol: document.getElementById('sensorProtocol').value
    };

    const response = await apiCall('/api/Sensors', {
        method: 'POST',
        body: JSON.stringify(data)
    });

    if (response.ok) {
        bootstrap.Modal.getInstance(document.getElementById('addSensorModal')).hide();
        document.getElementById('addSensorForm').reset();
        showAlert('Sensor added successfully', 'success');
        setTimeout(() => window.location.reload(), 1000);
    } else {
        showAlert('Failed to add sensor', 'danger');
    }
}

document.addEventListener('DOMContentLoaded', loadReadings);
initSignalR((type, data) => {
    if (type === 'reading' && data.canalId === '@Model.Canal?.Id') loadReadings();
});
</script>
}
