@page
@model COMS.Pages.Canals.IndexModel
@{
    ViewData["Title"] = "Canals";
}

<div class="page-header">
    <div class="title-group">
        <h2 class="page-title mb-1">Canal Management</h2>
        <p class="page-subtitle mb-0">Monitor and manage all registered canals.</p>
    </div>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createCanalModal">
        <i class="bi bi-plus-circle"></i> Add Canal
    </button>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover" id="canalsTable">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Location</th>
                        <th>Barangay</th>
                        <th>Status</th>
                        <th class="text-end">Length (m)</th>
                        <th>Sensors</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody id="canalsBody">
                </tbody>
            </table>
            <div id="canalsEmpty" class="empty-state" style="display:none;">
                <i class="bi bi-water"></i>
                <p class="empty-title">No canals found</p>
                <p>Register a canal to begin monitoring canal obstruction and flood risk.</p>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="createCanalModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add New Canal</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="createCanalForm">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" class="form-control" id="canalName" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Location</label>
                        <input type="text" class="form-control" id="canalLocation" required />
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Barangay</label>
                            <input type="text" class="form-control" id="canalBarangay" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Municipality</label>
                            <input type="text" class="form-control" id="canalMunicipality" value="Cebu City" />
                        </div>
                    </div>
                    <div class="row g-3 mt-1">
                        <div class="col-md-4">
                            <label class="form-label">Length (m)</label>
                            <input type="number" step="0.1" class="form-control" id="canalLength" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Width (m)</label>
                            <input type="number" step="0.1" class="form-control" id="canalWidth" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Depth (m)</label>
                            <input type="number" step="0.1" class="form-control" id="canalDepth" required />
                        </div>
                    </div>
                    <div class="row g-3 mt-1">
                        <div class="col-md-4">
                            <label class="form-label">Normal Level (m)</label>
                            <input type="number" step="0.1" class="form-control" id="canalNormal" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Warning Level (m)</label>
                            <input type="number" step="0.1" class="form-control" id="canalWarning" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Critical Level (m)</label>
                            <input type="number" step="0.1" class="form-control" id="canalCritical" required />
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" onclick="createCanal()">Save Canal</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
async function loadCanals() {
    showLoading();
    try {
        const response = await apiCall('/api/Canals');
        if (response.ok) {
            const canals = await response.json();
            const tbody = document.getElementById('canalsBody');
            const table = document.getElementById('canalsTable');
            const empty = document.getElementById('canalsEmpty');
            if (canals.length === 0) {
                tbody.innerHTML = '';
                table.style.display = 'none';
                empty.style.display = 'block';
            } else {
                table.style.display = 'table';
                empty.style.display = 'none';
                const statusBadge = c => c.status === 'Normal' ? 'bg-success' : c.status === 'Warning' ? 'bg-warning' : 'bg-danger';
                tbody.innerHTML = canals.map(c => `
                    <tr>
                        <td><strong>${c.name}</strong></td>
                        <td>${c.location}</td>
                        <td>${c.barangay || '<span class="text-muted">N/A</span>'}</td>
                        <td><span class="status-dot status-${c.status.toLowerCase()}"></span><span class="badge ${statusBadge(c)}">${c.status}</span></td>
                        <td class="text-end">${c.lengthMeters}</td>
                        <td>${c.sensorCount}</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-outline-primary" onclick="viewCanal('${c.id}')">View</button>
                        </td>
                    </tr>
                `).join('');
            }
        }
    } catch (e) {
        showAlert('Failed to load canals: ' + e.message, 'danger');
    } finally {
        hideLoading();
    }
}

async function createCanal() {
    const data = {
        name: document.getElementById('canalName').value,
        location: document.getElementById('canalLocation').value,
        barangay: document.getElementById('canalBarangay').value || undefined,
        municipality: document.getElementById('canalMunicipality').value || undefined,
        province: 'Cebu',
        lengthMeters: parseFloat(document.getElementById('canalLength').value),
        widthMeters: parseFloat(document.getElementById('canalWidth').value),
        depthMeters: parseFloat(document.getElementById('canalDepth').value),
        normalWaterLevel: parseFloat(document.getElementById('canalNormal').value),
        warningWaterLevel: parseFloat(document.getElementById('canalWarning').value),
        criticalWaterLevel: parseFloat(document.getElementById('canalCritical').value)
    };

    const response = await apiCall('/api/Canals', {
        method: 'POST',
        body: JSON.stringify(data)
    });

    if (response.ok) {
        bootstrap.Modal.getInstance(document.getElementById('createCanalModal')).hide();
        document.getElementById('createCanalForm').reset();
        loadCanals();
        showAlert('Canal created successfully', 'success');
    } else {
        showAlert('Failed to create canal', 'danger');
    }
}

function viewCanal(id) {
    window.location.href = `/Canals/Details?id=${id}`;
}

document.addEventListener('DOMContentLoaded', loadCanals);
</script>
}
