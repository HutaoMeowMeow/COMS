@page
@model COMS.Pages.Reports.IndexModel
@{
    ViewData["Title"] = "Community Reports";
}

<div class="page-header">
    <div class="title-group">
        <h2 class="page-title mb-1">Community Reports</h2>
        <p class="page-subtitle mb-0">Review and manage community-submitted canal reports.</p>
    </div>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createReportModal">
        <i class="bi bi-plus-circle"></i> Submit Report
    </button>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover" id="reportsTable">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Canal</th>
                        <th>Reported By</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th class="text-end">Reported At</th>
                    </tr>
                </thead>
                <tbody id="reportsBody">
                </tbody>
            </table>
        </div>
        <div id="reportsEmpty" class="empty-state" style="display:none;">
            <i class="bi bi-clipboard"></i>
            <p class="empty-title">No reports found</p>
            <p class="text-muted">There are currently no community reports to display.</p>
        </div>
    </div>
</div>

<div class="modal fade" id="createReportModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Submit Community Report</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="createReportForm">
                    <div class="mb-3">
                        <label class="form-label">Canal</label>
                        <select class="form-select" id="reportCanalId" required>
                            <option value="">Select Canal</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Report Type</label>
                        <select class="form-select" id="reportType">
                            <option value="Obstruction">Obstruction</option>
                            <option value="Debris">Debris</option>
                            <option value="Flooding">Flooding</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Title</label>
                        <input type="text" class="form-control" id="reportTitle" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" id="reportDescription" rows="3" required></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" onclick="createReport()">Submit Report</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
const reportStatusClass = s => s === 'Pending' ? 'bg-warning' : s === 'Verified' ? 'bg-info' : 'bg-success';

async function loadCanals() {
    try {
        const response = await apiCall('/api/Canals');
        if (response.ok) {
            const canals = await response.json();
            const select = document.getElementById('reportCanalId');
            select.innerHTML = '<option value="">Select Canal</option>' + canals.map(c => `<option value="${c.id}">${c.name}</option>`).join('');
        }
    } catch (e) {
        console.error('Failed to load canals', e);
    }
}

async function loadReports() {
    showLoading();
    try {
        const response = await apiCall('/api/Reports');
        if (response.ok) {
            const reports = await response.json();
            const tbody = document.getElementById('reportsBody');
            const table = document.getElementById('reportsTable');
            const empty = document.getElementById('reportsEmpty');
            if (reports.length === 0) {
                tbody.innerHTML = '';
                table.style.display = 'none';
                empty.style.display = 'block';
            } else {
                table.style.display = 'table';
                empty.style.display = 'none';
                tbody.innerHTML = reports.map(r => `
                    <tr>
                        <td><strong>${r.title}</strong></td>
                        <td>${r.canalName}</td>
                        <td>${r.reportedByUserName}</td>
                        <td>${r.reportType}</td>
                        <td><span class="badge ${reportStatusClass(r.status)}">${r.status}</span></td>
                        <td class="text-end">${new Date(r.reportedAt).toLocaleString()}</td>
                    </tr>
                `).join('');
            }
        }
    } catch (e) {
        showAlert('Failed to load reports: ' + e.message, 'danger');
    } finally {
        hideLoading();
    }
}

async function createReport() {
    const data = {
        canalId: document.getElementById('reportCanalId').value,
        reportType: document.getElementById('reportType').value,
        title: document.getElementById('reportTitle').value,
        description: document.getElementById('reportDescription').value
    };

    const response = await apiCall('/api/Reports', {
        method: 'POST',
        body: JSON.stringify(data)
    });

    if (response.ok) {
        bootstrap.Modal.getInstance(document.getElementById('createReportModal')).hide();
        document.getElementById('createReportForm').reset();
        loadReports();
        showAlert('Report submitted successfully', 'success');
    } else {
        showAlert('Failed to submit report', 'danger');
    }
}

document.addEventListener('DOMContentLoaded', () => { loadCanals(); loadReports(); });
</script>
}
