                    <td><span class="status-dot status-${s.status.toLowerCase()}"></span>${s.status}</td>
                    <td>${s.currentWaterLevel != null ? s.currentWaterLevel.toFixed(2) + ' m' : 'N/A'}</td>
                    <td>${s.currentRiskLevel || 'N/A'}</td>
                    <td>${s.lastReadingAt ? new Date(s.lastReadingAt).toLocaleString() : 'N/A'}</td>
                </tr>
            `).join('');
        }
    }

