@page
@model COMS.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header">
    <div class="title-group">
        <h2 class="page-title mb-1">Dashboard</h2>
        <p class="page-subtitle mb-0">Real-time overview of canal monitoring and flood risk status.</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="card-body">
                <div class="stat-icon bg-primary-soft"><i class="bi bi-water"></i></div>
                <div class="stat-content">
                    <h5 class="stat-label">Total Canals</h5>
                    <h2 class="stat-value" id="totalCanals">0</h2>
                    <small class="stat-caption">monitoring locations</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="card-body">
                <div class="stat-icon bg-info-soft"><i class="bi bi-gear"></i></div>
                <div class="stat-content">
                    <h5 class="stat-label">Total Sensors</h5>
                    <h2 class="stat-value" id="totalSensors">0</h2>
                    <small class="stat-caption">connected devices</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="card-body">
                <div class="stat-icon bg-danger-soft"><i class="bi bi-exclamation-triangle"></i></div>
                <div class="stat-content">
                    <h5 class="stat-label">Active Alerts</h5>
                    <h2 class="stat-value" id="activeAlerts">0</h2>
                    <small class="stat-caption" id="activeAlertsCaption">No active obstructions</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="card-body">
                <div class="stat-icon bg-warning-soft"><i class="bi bi-clipboard"></i></div>
                <div class="stat-content">
                    <h5 class="stat-label">Pending Reports</h5>
                    <h2 class="stat-value" id="pendingReports">0</h2>
                    <small class="stat-caption" id="pendingReportsCaption">No reports awaiting review</small>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-xl-6">
        <div class="card h-100">
            <div class="card-header">Canal Status Overview</div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover" id="canalsStatusTable">
                        <thead>
                            <tr>
                                <th>Canal</th>
                                <th>Status</th>
                                <th>Water Level</th>
                                <th>Risk</th>
                                <th>Last Reading</th>
                            </tr>
                        </thead>
                        <tbody id="canalsStatusBody">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-6">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Recent Alerts</span>
                <a href="/Alerts" class="small text-primary text-decoration-none">View all</a>
            </div>
            <div class="card-body alert-panel">
                <div id="recentAlertsList"></div>
                <div id="recentAlertsEmpty" class="empty-state" style="display:none;">
                    <i class="bi bi-check-circle"></i>
                    <p class="empty-title">No active alerts</p>
                    <p class="text-muted">All canal obstructions are currently clear. Alerts will appear here when detected.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mt-1">
    <div class="col-xl-6">
        <div class="card h-100">
            <div class="card-header">Alerts by Canal</div>
            <div class="card-body">
                <div class="chart-container">
                    <canvas id="alertsChart"></canvas>
                    <div id="alertsChartEmpty" class="chart-empty" style="display:none;">
                        <div class="empty-state mb-0">
                            <i class="bi bi-bar-chart"></i>
                            <p class="empty-title">No analytics data yet</p>
                            <p>Chart will appear when alert data is recorded.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-6">
        <div class="card h-100">
            <div class="card-header">Risk Levels by Canal</div>
            <div class="card-body">
                <div class="chart-container">
                    <canvas id="riskChart"></canvas>
                    <div id="riskChartEmpty" class="chart-empty" style="display:none;">
                        <div class="empty-state mb-0">
                            <i class="bi bi-pie-chart"></i>
                            <p class="empty-title">No risk data yet</p>
                            <p>Risk distribution will appear when assessments are recorded.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
let alertsChart = null;
let riskChart = null;

async function loadDashboard() {
    showLoading();
    try {
        const summaryRes = await apiCall('/api/Dashboard/summary');
        if (summaryRes.ok) {
            const summary = await summaryRes.json();
            document.getElementById('totalCanals').textContent = summary.totalCanals;
            document.getElementById('totalSensors').textContent = summary.totalSensors;
            document.getElementById('activeAlerts').textContent = summary.activeAlerts;
            document.getElementById('activeAlertsCaption').textContent =
                summary.activeAlerts === 0 ? 'No active obstructions' : summary.activeAlerts + ' active obstructions';
            document.getElementById('pendingReports').textContent = summary.pendingReports;
            document.getElementById('pendingReportsCaption').textContent =
                summary.pendingReports === 0 ? 'No reports awaiting review' : summary.pendingReports + ' reports awaiting review';
        }

        const statusRes = await apiCall('/api/Canals/status');
        if (statusRes.ok) {
            const statuses = await statusRes.json();
            const tbody = document.getElementById('canalsStatusBody');
            if (statuses.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" class="empty-cell"><i class="bi bi-water"></i> No canals registered.</td></tr>';
            } else {
                tbody.innerHTML = statuses.map(s => `
                    <tr>
                        <td><strong>${s.canalName}</strong></td>
                        <td><span class="status-dot status-${s.status.toLowerCase()}"></span><span class="badge badge-status">${s.status}</span></td>
                        <td>${s.currentWaterLevel != null ? s.currentWaterLevel.toFixed(2) + ' m' : 'N/A'}</td>
                        <td>${s.currentRiskLevel || 'N/A'}</td>
                        <td>${s.lastReadingAt ? new Date(s.lastReadingAt).toLocaleString() : 'N/A'}</td>
                    </tr>
                `).join('');
            }
        }

        const alertsRes = await apiCall('/api/Alerts/active');
        if (alertsRes.ok) {
            const alerts = await alertsRes.json();
            const list = document.getElementById('recentAlertsList');
            const empty = document.getElementById('recentAlertsEmpty');
            if (alerts.length === 0) {
                list.innerHTML = '';
                empty.style.display = 'block';
            } else {
                empty.style.display = 'none';
                list.innerHTML = alerts.slice(0, 10).map(a => `
                    <div class="alert alert-${a.severity === 'High' ? 'danger' : 'warning'} mb-2">
                        <strong>${a.title}</strong><br/>
                        <small>${a.description}</small><br/>
                        <small class="text-muted">${new Date(a.triggeredAt).toLocaleString()}</small>
                    </div>
                `).join('');
            }
        }

        const analyticsRes = await apiCall('/api/Risk/analytics');
        if (analyticsRes.ok) {
            const analytics = await analyticsRes.json();
            const labels = analytics.map(a => a.canalName);
            const totalData = analytics.map(a => a.totalAlerts);
            const activeData = analytics.map(a => a.activeAlerts);
            const riskData = analytics.map(a => a.currentRiskLevel);

            const canvas1 = document.getElementById('alertsChart');
            const canvas1Empty = document.getElementById('alertsChartEmpty');
            const canvas2 = document.getElementById('riskChart');
            const canvas2Empty = document.getElementById('riskChartEmpty');

            if (analytics.length === 0) {
                canvas1.style.display = 'none';
                canvas1Empty.style.display = 'flex';
                canvas2.style.display = 'none';
                canvas2Empty.style.display = 'flex';
            } else {
                canvas1.style.display = 'block';
                canvas1Empty.style.display = 'none';
                if (alertsChart) alertsChart.destroy();
                const ctx1 = canvas1.getContext('2d');
                alertsChart = new Chart(ctx1, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [
                            { label: 'Total Alerts', data: totalData, backgroundColor: '#0d6efd' },
                            { label: 'Active Alerts', data: activeData, backgroundColor: '#dc3545' }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: { y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.05)' } } },
                        plugins: { legend: { position: 'top' } }
                    }
                });

                canvas2.style.display = 'block';
                canvas2Empty.style.display = 'none';
                const riskCounts = {};
                riskData.forEach(r => { riskCounts[r] = (riskCounts[r] || 0) + 1; });
                if (riskChart) riskChart.destroy();
                const ctx2 = canvas2.getContext('2d');
                riskChart = new Chart(ctx2, {
                    type: 'doughnut',
                    data: {
                        labels: Object.keys(riskCounts),
                        datasets: [{
                            data: Object.values(riskCounts),
                            backgroundColor: ['#198754', '#f59f00', '#dc3545']
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { position: 'bottom' } }
                    }
                });
            }
        }
    } catch (e) {
        console.error('Dashboard load error:', e);
        showAlert('Failed to load dashboard: ' + e.message, 'danger');
    } finally {
        hideLoading();
    }
}

document.addEventListener('DOMContentLoaded', loadDashboard);
initSignalR((type, data) => {
    if (type === 'alert') loadDashboard();
});
</script>
}
